{
  "private": true,
  "name": "squoosh",
  "version": "2.0.0",
  "license": "apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs && node lib/move-output.mjs",
    "debug": "node --inspect-brk ./node_modules/rollup/dist/bin/rollup -c rollup.config.mjs",
    "dev": "DEV_PORT=\"${DEV_PORT:=5000}\" pnpm --parallel run watch serve",
    "watch": "rollup -cw rollup.config.mjs",
    "serve": "node lib/dev-server.mjs",
    "test": "node test/run.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/pluginutils": "^5.3.0",
    "@types/node": "^25.9.3",
    "comlink": "^4.4.2",
    "cssnano": "^8.0.2",
    "estree-walker": "^3.0.3",
    "husky": "^9.1.7",
    "idb-keyval": "^6.2.5",
    "image-size": "^2.0.2",
    "lint-staged": "^17.0.7",
    "magic-string": "^0.30.21",
    "postcss": "^8.5.3",
    "postcss-modules": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-url": "^10.1.4",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.8.4",
    "rollup": "^4.62.0",
    "typescript": "^6.0.3",
    "wasm-feature-detect": "^1.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,tsx}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
